# Copy values into your shell environment or CI secret store.
# Do not commit real credentials.
DATAOPS_POSTGRES_PASSWORD=replace-with-a-local-development-secret
DATAOPS_AGENT_TOKEN=replace-with-a-random-agent-bearer-token
DATAOPS_PUBLIC_URL=https://dataops.example.com
DATAOPS_WEB_SESSION_COOKIE_SECURE=true
DATAOPS_WEB_SESSION_TTL_HOURS=12
DATAOPS_ELASTICSEARCH_URL=http://localhost:9201
DATAOPS_ELASTICSEARCH_LOG_RETENTION=30d
DATAOPS_EMBEDDING_URL=http://host.docker.internal:11434
DATAOPS_EMBEDDING_MODEL=bge-m3:567m
DATAOPS_EMBEDDING_DIMENSIONS=1024
DATAOPS_EMBEDDING_TIMEOUT_SECONDS=60
DATAOPS_LLM_URL=http://host.docker.internal:11434
DATAOPS_LLM_MODEL=gemma4:e2b
DATAOPS_LLM_TIMEOUT_SECONDS=300
DATAOPS_LLM_CONTEXT_TOKENS=8192
DATAOPS_RCA_PROMPT_VERSION=rca-v1
DATAOPS_RCA_CONTEXT_MAX_CHARS=16000
DATAOPS_GITHUB_API_URL=https://api.github.com

# Optional for public repositories; required for private repositories and higher rate limits.
# DATAOPS_GITHUB_TOKEN=github-token-with-read-only-contents-permission

# Optional M6 recovery executor. Store the token in a secret manager, never in Git.
# The fine-grained token needs Actions: write only for repositories under recovery control.
# DATAOPS_GITHUB_RECOVERY_TOKEN=github-token-with-actions-write-permission
DATAOPS_GITHUB_RECOVERY_WORKFLOW=dataops-recovery.yml
DATAOPS_GITHUB_RECOVERY_TIMEOUT_SECONDS=15

# Production options for a TLS-enabled self-managed cluster:
# DATAOPS_ELASTICSEARCH_API_KEY=encoded-api-key
# DATAOPS_ELASTICSEARCH_CA_CERTS=/run/secrets/elasticsearch-ca.crt
# DATAOPS_ELASTICSEARCH_VERIFY_CERTS=true

# Provider Selection: ollama | gemini | deepseek
DATAOPS_LLM_PROVIDER=ollama
DATAOPS_EMBEDDING_PROVIDER=ollama

# Google Gemini (Free tier via Google AI Studio)
# DATAOPS_GEMINI_API_KEY=your-gemini-api-key
# DATAOPS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# DATAOPS_GEMINI_LLM_MODEL=gemini-flash-latest
# DATAOPS_GEMINI_EMBEDDING_MODEL=text-embedding-004
# DATAOPS_GEMINI_EMBEDDING_DIMENSIONS=768

# DeepSeek (OpenAI compatible)
# DATAOPS_DEEPSEEK_API_KEY=your-deepseek-api-key
# DATAOPS_DEEPSEEK_BASE_URL=https://api.deepseek.com
# DATAOPS_DEEPSEEK_LLM_MODEL=deepseek-chat

